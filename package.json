{
  "name": "kpccw-choir-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/run.mjs",
    "find-recordings": "node scripts/find-recordings.mjs",
    "icons": "node scripts/render-icons.mjs",
    "og": "RUN_ENTRY=scripts/og-tags.ts node scripts/run.mjs",
    "gas:login": "npx --yes @google/clasp@2.4.2 login",
    "gas:push": "npx --yes @google/clasp@2.4.2 push",
    "gas:deploy": "npx --yes @google/clasp@2.4.2 push && npx --yes @google/clasp@2.4.2 deploy --deploymentId \"$GAS_DEPLOYMENT_ID\" --description \"npm run gas:deploy\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
